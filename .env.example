# ROAD MINERS — modèle (copier en .env et remplir)
# Le vrai .env est local uniquement et gitignoré.

# Supabase (https://supabase.com/dashboard → votre projet → Settings → API)
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
SUPABASE_KEY=sb_secret_...              # côté serveur uniquement (import)
SUPABASE_ACCESS_TOKEN=sbp_...           # API de gestion (DDL, déploiement fonctions)

# GitHub (Settings → Developer settings → Personal access tokens)
GITHUB_TOKEN=github_pat_...             # ou ghp_... avec scope repo

# Vercel : pas de jeton requis si le projet est branché sur le dépôt GitHub
